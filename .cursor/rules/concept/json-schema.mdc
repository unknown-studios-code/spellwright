# JSON Schema for Spell Definition

This file contains the complete JSON schema that defines the data contract between the LLM and the game engine in Spellwright. This is the mandatory format that every spell must follow.

## Complete JSON Schema

```json
{
  "type": "object",
  "properties": {
    "spellName": {
      "type": "string",
      "description": "The descriptive name of the spell.",
      "minLength": 1,
      "maxLength": 100
    },
    "generator": {
      "type": "object",
      "description": "Defines the fundamental form and delivery method of the spell.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["projectile", "cone", "self_cast", "area_of_effect"],
          "description": "Type of spell generator."
        },
        "speed": {
          "type": "number",
          "description": "Initial speed for projectiles (units/second).",
          "minimum": 0,
          "maximum": 1000
        },
        "lifetime": {
          "type": "number",
          "description": "Duration in seconds for projectiles or areas of effect.",
          "minimum": 0.1,
          "maximum": 60
        },
        "count": {
          "type": "integer",
          "description": "Number of projectiles to be fired.",
          "minimum": 1,
          "maximum": 100
        },
        "radius": {
          "type": "number",
          "description": "Radius for areas of effect or cones (units).",
          "minimum": 0.1,
          "maximum": 100
        },
        "angle": {
          "type": "number",
          "description": "Angle for cone-type generators (degrees).",
          "minimum": 1,
          "maximum": 360
        }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "projectile" } }
          },
          "then": {
            "required": ["speed", "lifetime"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "area_of_effect" } }
          },
          "then": {
            "required": ["radius", "lifetime"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "cone" } }
          },
          "then": {
            "required": ["radius", "angle", "lifetime"]
          }
        }
      ]
    },
    "modifiers": {
      "type": "array",
      "description": "A list of behaviors that alter the basic functionality of the generator.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["homing", "chain", "pierce", "multi_shot", "on_impact_trigger", "fork"],
            "description": "Type of modifier."
          },
          "turn_speed": {
            "type": "number",
            "description": "Turn speed for 'homing' modifier (units/second).",
            "minimum": 0,
            "maximum": 100
          },
          "max_bounces": {
            "type": "integer",
            "description": "Maximum number of bounces for 'chain' modifier.",
            "minimum": 1,
            "maximum": 20
          },
          "pierce_count": {
            "type": "integer",
            "description": "Number of targets that can be pierced.",
            "minimum": 1,
            "maximum": 50
          },
          "fork_count": {
            "type": "integer",
            "description": "Number of projectiles generated on fork.",
            "minimum": 2,
            "maximum": 10
          },
          "fork_angle": {
            "type": "number",
            "description": "Spread angle for fork (degrees).",
            "minimum": 1,
            "maximum": 180
          },
          "spread_angle": {
            "type": "number",
            "description": "Spread angle for multi-shot (degrees).",
            "minimum": 0,
            "maximum": 180
          }
        },
        "required": ["type"],
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "homing" } }
            },
            "then": {
              "required": ["turn_speed"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "chain" } }
            },
            "then": {
              "required": ["max_bounces"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "pierce" } }
            },
            "then": {
              "required": ["pierce_count"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "fork" } }
            },
            "then": {
              "required": ["fork_count", "fork_angle"]
            }
          }
        ]
      },
      "maxItems": 10
    },
    "payloads": {
      "type": "array",
      "description": "A list of effects that are applied on impact or activation.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["damage", "heal", "apply_status_effect", "spawn_entity"],
            "description": "Type of payload."
          },
          "amount": {
            "type": "number",
            "description": "Amount of damage or healing.",
            "minimum": 0,
            "maximum": 10000
          },
          "elemental_type": {
            "type": "string",
            "enum": ["fire", "frost", "shock", "physical", "holy"],
            "description": "Elemental type of damage."
          },
          "effect_name": {
            "type": "string",
            "enum": ["slow", "burn", "stun", "poison"],
            "description": "Name of status effect to be applied."
          },
          "duration": {
            "type": "number",
            "description": "Duration for status effects (seconds).",
            "minimum": 0.1,
            "maximum": 60
          },
          "entity_prefab": {
            "type": "string",
            "description": "Name of entity prefab to be spawned."
          }
        },
        "required": ["type"],
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "damage" } }
            },
            "then": {
              "required": ["amount", "elemental_type"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "heal" } }
            },
            "then": {
              "required": ["amount"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "apply_status_effect" } }
            },
            "then": {
              "required": ["effect_name", "duration"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "spawn_entity" } }
            },
            "then": {
              "required": ["entity_prefab"]
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
  "required": ["spellName", "generator", "payloads"]
}
```

## Valid JSON Examples

### Example 1: Simple Fireball

```json
{
  "spellName": "Fireball",
  "generator": {
    "type": "projectile",
    "speed": 30.0,
    "lifetime": 5.0
  },
  "modifiers": [],
  "payloads": [
    {
      "type": "damage",
      "amount": 25.0,
      "elemental_type": "fire"
    }
  ]
}
```


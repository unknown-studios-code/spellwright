### Layer 3: Client-Side Validation

Always validate received JSON before processing.

```csharp
using Newtonsoft.Json;
using Newtonsoft.Json.Schema;

public class SpellJsonValidator
{
    private JSchema schema;

    public SpellJsonValidator()
    {
        // Load schema from Resources or file
        string schemaJson = Resources.Load<TextAsset>("SpellSchema").text;
        schema = JSchema.Parse(schemaJson);
    }

    public bool ValidateSpellJson(string jsonString, out List<string> errors)
    {
        errors = new List<string>();

        try
        {
            // 1. Check if it's valid JSON
            JObject spellObj = JObject.Parse(jsonString);

            // 2. Validate against schema
            bool isValid = spellObj.IsValid(schema, out IList<string> schemaErrors);

            if (!isValid)
            {
                errors.AddRange(schemaErrors);
                return false;
            }

            // 3. Custom validations
            if (!ValidateCustomRules(spellObj, out var customErrors))
            {
                errors.AddRange(customErrors);
                return false;
            }

            return true;
        }
        catch (JsonException e)
        {
            errors.Add($"Invalid JSON: {e.Message}");
            return false;
        }
    }

    private bool ValidateCustomRules(JObject spellObj, out List<string> errors)
    {
        errors = new List<string>();

        // Check if has at least one payload
        var payloads = spellObj["payloads"];
        if (payloads == null || !payloads.Any())
        {
            errors.Add("Spell must have at least one payload");
            return false;
        }

        // Check reasonable numeric values
        var generator = spellObj["generator"];
        if (generator["speed"] != null)
        {
            float speed = generator["speed"].Value<float>();
            if (speed <= 0 || speed > 1000)
            {
                errors.Add($"Speed out of reasonable range: {speed}");
                return false;
            }
        }

        return true;
    }
}
```

## Rule 3: Robust Error Handling

### Error Categories

1.  **Network Error** - Timeout, no connection
2.  **API Error** - Rate limit, authentication, server error (5xx)
3.  **Validation Error** - Invalid JSON, schema mismatch
4.  **Semantic Error** - Valid JSON but logically meaningless

### Implementation

```csharp
public async Task<string> CreateSpellJsonAsync(string userPrompt)
{
    try
    {
        string json = await CallLLMApiAsync(userPrompt);

        // Validate
        if (!validator.ValidateSpellJson(json, out var errors))
        {
            // Validation error - try again with feedback
            string errorFeedback = string.Join(", ", errors);
            Debug.LogWarning($"Invalid JSON: {errorFeedback}. Retrying...");

            // Retry with error message
            json = await RetryWithFeedback(userPrompt, errorFeedback);

            // Validate again
            if (!validator.ValidateSpellJson(json, out errors))
            {
                throw new SpellCreationException("Validation failed after retry", errors);
            }
        }

        return json;
    }
    catch (UnityWebRequestException e)
    {
        // Network error
        throw new SpellCreationException("Network error connecting to LLM", e);
    }
    catch (HttpException e)
    {
        // API error
        if (e.StatusCode == 429)
        {
            throw new SpellCreationException("Rate limit reached. Try again in a few seconds.", e);
        }
        throw new SpellCreationException($"LLM API error: {e.Message}", e);
    }
}
```

## Rule 4: Complete Logging for Debug

### What to Log

```csharp
public async Task<string> CreateSpellJsonAsync(string userPrompt)
{
    // 1. Log user input
    Debug.Log($"[LLM] User Input: {userPrompt}");

    // 2. Log complete prompt sent
    string fullPrompt = BuildFullPrompt(userPrompt);
    Debug.Log($"[LLM] Full Prompt Length: {fullPrompt.Length} chars");

    // 3. Log request
    Debug.Log($"[LLM] Sending request to {API_ENDPOINT}");

    string json = await CallLLMApiAsync(fullPrompt);

    // 4. Log raw response
    Debug.Log($"[LLM] Raw Response: {json}");

    // 5. Log validation
    if (validator.ValidateSpellJson(json, out var errors))
    {
        Debug.Log("[LLM] ✓ Valid JSON");
    }
    else
    {
        Debug.LogError($"[LLM] ✗ Invalid JSON: {string.Join(", ", errors)}");
    }

    return json;
}
```

## Rule 5: Configuration and Security

### API Key Management

```csharp
// NEVER hardcode API key in code
// Use ScriptableObject or configuration file

[CreateAssetMenu(fileName = "LLMConfig", menuName = "Spellwright/LLM Config")]
public class LLMConfig : ScriptableObject
{
    [SerializeField] private string apiKey;
    [SerializeField] private string apiEndpoint = "https://api.openai.com/v1/chat/completions";
    [SerializeField] private string model = "gpt-4";
    [SerializeField] private int maxRetries = 3;
    [SerializeField] private float timeoutSeconds = 30f;

    public string ApiKey => apiKey;
    public string ApiEndpoint => apiEndpoint;
    public string Model => model;
    public int MaxRetries => maxRetries;
    public float TimeoutSeconds => timeoutSeconds;
}
```

### Timeout and Retry

```csharp
public async Task<string> CreateSpellJsonAsync(string userPrompt)
{
    int retryCount = 0;

    while (retryCount < config.MaxRetries)
    {
        try
        {
            var cts = new CancellationTokenSource(
                TimeSpan.FromSeconds(config.TimeoutSeconds)
            );

            return await CallLLMApiAsync(userPrompt, cts.Token);
        }
        catch (OperationCanceledException)
        {
            retryCount++;
            Debug.LogWarning($"Timeout on attempt {retryCount}/{config.MaxRetries}");

            if (retryCount >= config.MaxRetries)
            {
                throw new SpellCreationException("Timeout after multiple attempts");
            }

            await Task.Delay(1000 * retryCount); // Exponential backoff
        }
    }

    throw new SpellCreationException("Failed after multiple attempts");
}
```

## Comparison of JSON Generation Techniques

| Technique             | Description              | Pros                         | Cons                     | Use in Spellwright        |
| --------------------- | ------------------------ | ---------------------------- | ------------------------ | ------------------------- |
| **Basic Prompting**   | Ask for JSON in prompt   | Easy                         | Unreliable               | ❌ Inadequate             |
| **Schema in Prompt**  | Include schema in prompt | Improves structure           | Doesn't guarantee syntax | ⚠️ Insufficient alone     |
| **JSON Mode**         | API parameter            | Guarantees valid syntax      | Less schema control      | ✅ Acceptable alternative |
| **Function Calling**  | Schema as tool           | Guarantees syntax and schema | API-specific             | ✅ **Main approach**      |
| **Few-Shot**          | Examples in prompt       | Improves semantics           | Increases prompt size    | ✅ **Essential**          |
| **Client Validation** | Validate in Unity        | Last line of defense         | Additional overhead      | ✅ **Mandatory**          |

## Important Notes

-   **Asynchronous communication** is mandatory - never block main thread
-   Use **Function Calling** from API as first line of defense
-   **Few-shot prompting** is essential for semantic accuracy
-   **Always validate** JSON on client before processing
-   Implement **detailed logging** to facilitate debugging
-   Use **retry with exponential backoff** for temporary errors
-   **Never hardcode** API keys - use external configuration
-   Define **appropriate timeouts** (e.g., 30 seconds)
-   Handle **all error types** explicitly
-   Consult the `json-schema.mdc` file for complete JSON schema
-   Keep few-shot examples **updated** with new spell types
-   Use **CancellationToken** to allow cancellation of long requests

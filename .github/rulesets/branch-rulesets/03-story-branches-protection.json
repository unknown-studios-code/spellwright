{
    "enforcement": "active",
    "name": "Story Branches Protection",
    "target": "branch",
    "bypass_actors": [
        {
            "actor_id": 5,
            "actor_type": "RepositoryRole",
            "bypass_mode": "always"
        }
    ],
    "conditions": {
        "ref_name": {
            "exclude": [],
            "include": ["refs/heads/feature/develop/SPWS-*"]
        }
    },
    "rules": [
        {
            "type": "required_status_checks",
            "parameters": {
                "required_status_checks": [
                    {
                        "context": "Validate PR title"
                    },
                    {
                        "context": "Build Unity Project (Windows)"
                    }
                ],
                "strict_required_status_checks_policy": false
            }
        },
        {
            "type": "deletion"
        }
    ]
}
